# SnehaVrinda Kala — environment variables
# Copy to .env and fill in values. Never commit real credentials.
#
# `docker compose up -d --build` needs only JWT_SECRET, COOKIE_SECRET and the
# admin email/password below. The Medusa region, sales channel and publishable
# API key are created automatically on first start and picked up by the
# storefront, so they must NOT be copied between machines.

# Storefront (Next.js)
# Public address of the site. Use http://localhost:3000 for local work.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@snehavrinda.in
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Medusa (server-side storefront client)
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Leave empty. The storefront resolves these from the backend at start-up;
# values from another machine point at records that do not exist here and every
# Store API call fails with "Publishable key not valid".
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
MEDUSA_CURRENCY_CODE=inr
MEDUSA_REQUEST_TIMEOUT_MS=10000

# Backend (Medusa v2)
#
# DATABASE_URL / REDIS_URL inside the containers are derived from
# CONTAINER_DATABASE_URL / CONTAINER_REDIS_URL below. They are deliberately NOT
# named DATABASE_URL / REDIS_URL: those names are what host tooling (psql,
# Medusa studio) uses, and a host URL such as localhost:5433 injected into a
# container means "this container's own loopback", where no database listens.
# That exact mix-up made the backend log "database unreachable" and never become
# healthy. A managed database goes here instead, with TLS:
#   CONTAINER_DATABASE_URL=postgresql://user:pass@db.example.com:5432/medusa?sslmode=require
#   CONTAINER_REDIS_URL=rediss://:password@cache.example.com:6379
# The local Postgres container serves plain TCP, hence sslmode=disable in its
# default: Medusa turns TLS on for any host that is not localhost, so omitting it
# makes every migration hang until it reports "pool is probably full".
# DATABASE_URL=postgresql://medusa:medusa@postgres:5432/medusa?sslmode=disable
# REDIS_URL=redis://redis:6379

# Local Postgres credentials (only used by the bundled postgres container).
POSTGRES_USER=medusa
POSTGRES_PASSWORD=medusa
POSTGRES_DB=medusa

# Host ports. All three are bound to 127.0.0.1, so they are reachable from this
# machine only — which is what you want on a cloud VM. Change the left number
# when something else already owns the port.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
BACKEND_PORT=9000
STOREFRONT_PORT=3000

MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:9000/app
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7000,http://localhost:3000
AUTH_CORS=http://localhost:3000

# ── Cloud / TLS ───────────────────────────────────────────────────────────
# Only used by `docker compose --profile proxy up -d`, which puts Caddy in
# front with automatic certificates. Point both DNS records at the host first.
# Two hostnames because the shop's /admin/* pages and Medusa's /admin/* API
# cannot share one origin.
STOREFRONT_DOMAIN=shop.example.com
API_DOMAIN=api.example.com

# When deploying behind a domain, override the URLs above too, e.g.
#   NEXT_PUBLIC_STOREFRONT_URL=https://shop.example.com
#   MEDUSA_BACKEND_URL=https://api.example.com
#   STORE_CORS=https://shop.example.com
#   ADMIN_CORS=https://shop.example.com,https://api.example.com
#   AUTH_CORS=https://shop.example.com,https://api.example.com
#   STOREFRONT_URL=https://shop.example.com
# NEXT_PUBLIC_STOREFRONT_URL is baked into the client bundle, so it must be set
# BEFORE the first storefront build.

# Starter catalogue created on first start. Set to 0 to provision only the
# shop wiring (region, channel, key, shipping) and add products yourself.
SEED_CATALOGUE=1

# Generate strong unique values for each environment, e.g.
#   openssl rand -hex 32
# NOTE: Any secret previously committed to Git must be treated as exposed and
# rotated here. Never commit real secrets to version control.
JWT_SECRET=
COOKIE_SECRET=

# Internal service-to-service auth. The Medusa backend pushes realtime admin
# notifications to the storefront with this shared secret. If unset, realtime
# notifications are skipped (nothing breaks, nothing arrives).
#   openssl rand -hex 32
INTERNAL_NOTIFY_SECRET=
# Storefront URL the backend should call for realtime notifications.
STOREFRONT_URL=https://snehavrinda.in

# Admin — comma-separated emails allowed into the storefront admin panel.
# ADMIN_EMAIL signs into both the storefront admin panel and the Medusa API.
ADMIN_EMAILS=admin@snehavrindakala.example
ADMIN_EMAIL=admin@snehavrindakala.example
ADMIN_PASSWORD=changeme-admin-password
# Optional second Medusa system user for admin API calls made by the storefront.
# Defaults to ADMIN_EMAIL when empty.
MEDUSA_ADMIN_EMAIL=
MEDUSA_ADMIN_PASSWORD=

# Refunds at or above this amount (in rupees) need two admins: the one who
# requests it cannot be the one who approves it. Leave blank for the default of
# 5000. Set 0 only if you want a second signature on every refund.
REFUND_APPROVAL_THRESHOLD=5000

# GST — seller's home state decides CGST+SGST vs IGST. Prices are treated as
# GST-inclusive; the amount is extracted, not added on top.
SELLER_HOME_STATE=Karnataka
GST_RATE=5

# Payments — Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# 1 = let Medusa's payment module own the checkout session (pp_razorpay_razorpay).
# Off unless someone has run a sandbox purchase on that path; see docs/DEPLOY.md.
CHECKOUT_RAZORPAY_PROVIDER=0
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Shipping — Shiprocket
SHIPROCKET_API_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Shiprocket webhook token: reject forged tracking callbacks. Unset = refused.
SHIPROCKET_WEBHOOK_TOKEN=

# CMS — Sanity (editorial content only)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Email — Amazon SES (or vetted equivalent)
# Without FROM_EMAIL and SES credentials nothing is sent: the notification module
# renders the message, records it as `skipped`, and the shop keeps working.
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Optional: SES configuration set for open/click/bounce tracking
AWS_SES_CONFIGURATION_SET=
# Verified sender. Without this, emails are rendered and logged, not sent.
FROM_EMAIL=
FROM_NAME=SnehaVrinda Kala
# Where new commission requests are announced internally.
COMMISSION_INBOX=

# Public addresses used in email footers and links
NEXT_PUBLIC_CONTACT_EMAIL=hello@snehavrinda.in
CONTACT_EMAIL=hello@snehavrinda.in

# Social profiles. Only networks with a URL here appear in the footer and in
# schema.org sameAs. Leave blank to omit the link entirely rather than ship an
# icon that goes nowhere.
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_PINTEREST=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=

# Monitoring
SENTRY_DSN=

# Cloud / region
AWS_REGION=ap-south-1

# Scheduled jobs. Anything at /api/cron/* refuses to run until this is set —
# an unset secret disables the job instead of opening it to the internet.
# Generate one with: openssl rand -hex 32
# Generate with: openssl rand -hex 32
CRON_SECRET=

# A cart counts as abandoned after this many quiet hours. Only one reminder is
# ever sent per cart.
ABANDONED_CART_HOURS=6
# How often the `cron` compose service runs the reminder job (default 6 hours).
CRON_INTERVAL_SECONDS=21600

# Where nightly dumps are copied off this machine. Empty = no off-site copy, and
# the nightly job says so in its log. Any rsync destination (host:/path) or an
# s3:// URL when the AWS CLI is installed. See docs/BACKUPS.md.
BACKUP_OFFSITE_TARGET=
