# SnehaVrinda Kala — environment variables
# Copy to .env and fill in values. Never commit real credentials.

# Storefront (Next.js)
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@snehavrindakala.example
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Medusa (server-side storefront client)
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
MEDUSA_CURRENCY_CODE=inr
MEDUSA_REQUEST_TIMEOUT_MS=10000

# Backend (Medusa v2)
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:9000/app
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7000,http://localhost:3000
AUTH_CORS=http://localhost:3000

# Generate strong unique values for each environment, e.g.
#   openssl rand -hex 32
# NOTE: Any secret previously committed to Git must be treated as exposed and
# rotated here. Never commit real secrets to version control.
JWT_SECRET=
COOKIE_SECRET=

# Admin — comma-separated emails allowed to access the partner admin panel
ADMIN_EMAILS=

# Payments — Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Shipping — Shiprocket
SHIPROCKET_API_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# CMS — Sanity (editorial content only)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=

# Email — Amazon SES (or vetted equivalent)
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
FROM_EMAIL=

# Monitoring
SENTRY_DSN=

# Cloud / region
AWS_REGION=ap-south-1
