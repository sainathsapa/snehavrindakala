# SnehaVrinda Kala — environment variables (variable names only, no real credentials)
# Copy to .env and fill in values per environment.

# Storefront (Next.js)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Backend (Medusa v2)
DATABASE_URL=postgresql://medusa:medusa@localhost:5432/medusa
REDIS_URL=redis://localhost:6379
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_ADMIN_URL=http://localhost:9000/app
JWT_SECRET=
COOKIE_SECRET=

# Payments — Razorpay (adapter boundary, test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping — Shiprocket
SHIPROCKET_API_TOKEN=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# CMS — Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=
SANITY_API_TOKEN=
SANITY_API_VERSION=2026-01-01

# Email — Amazon SES (or vetted equivalent)
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
FROM_EMAIL=

# Monitoring
SENTRY_DSN=

# Cloud / region
AWS_REGION=ap-south-1
