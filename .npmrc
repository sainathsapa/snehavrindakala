# Allow lifecycle/build scripts for dependencies.
# pnpm 12's supply-chain policy blocks native-module build scripts by default.
ignore-scripts=false
unsafe-perm=true

# NOTE: dependency overrides do NOT belong here.
#
# This file previously carried `overrides=vitest@3.2.6 tinypool@2.1.2` in an
# attempt to pull tinypool off a vulnerable version. pnpm does not read
# `overrides` from .npmrc — on pnpm 12 the only honoured locations are the
# `overrides` key in pnpm-workspace.yaml or `pnpm.overrides` in the root
# package.json. The line was silently inert, which is why the audit kept
# reporting tinypool 1.1.1 while the config looked fixed.
#
# Overrides now live in pnpm-workspace.yaml, where they actually apply, and are
# kept to the minimum: a dependency upgrade is always preferred to an override.
