# Allow lifecycle/build scripts for dependencies.
# Required because pnpm 12's supply-chain policy (--frozen-lockfile) ignores
# native-module build scripts (sharp, esbuild, msgpackr-extract, protobufjs,
# @medusajs/telemetry) by default, which causes ERR_PNPM_IGNORED_BUILDS.
ignore-scripts=false
unsafe-perm=true
