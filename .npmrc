# Allow lifecycle/build scripts for dependencies.
# pnpm 12's supply-chain policy blocks native-module build scripts by default.
ignore-scripts=false
unsafe-perm=true

# Force transitive dev dependencies with critical vulnerabilities to patched
# versions. These come from Sanity's dependency tree and are not part of our
# runtime bundle (build plan Phase 1 / P0 blocker #6).
overrides=vitest@3.2.6 tinypool@2.1.2
