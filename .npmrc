# Allow lifecycle/build scripts for dependencies.
# Required because pnpm 12's supply-chain policy ignores native-module build
# scripts by default, which causes ERR_PNPM_IGNORED_BUILDS.
ignore-scripts=false
unsafe-perm=true
# Allowlist packages whose build scripts must run (sharp, esbuild, etc.)
ignored-build-scripts-allowlist=@medusajs/telemetry,esbuild,msgpackr-extract,protobufjs,sharp
